<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews only supports a small subset of views/attributes (no custom
  views, no gradients via style, limited layout types) — this stays simple
  on purpose: a dark rounded card with four stacked text lines.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NET THIS MONTH"
        android:textColor="#9797A6"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/widget_net"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="#FBBF24"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#F5F5F7"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_bill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#9797A6"
        android:textSize="10.5sp" />
</LinearLayout>
